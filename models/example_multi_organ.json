{
  "metadata": {
    "name": "Cardiovascular-Renal Coupled Model",
    "version": "1.1",
    "description": "Coupled model of hemodynamics and renal sodium/water excretion with Baroreflex and RAAS feedback.",
    "confidence_score": 0.95
  },
  "variables": [
    {"name": "MAP", "unit": "mmHg", "initial_value": 100.0, "type": "state", "description": "Mean arterial pressure"},
    {"name": "ECBV", "unit": "mL", "initial_value": 5000.0, "type": "state", "description": "Extracellular fluid volume"},
    {"name": "Na_ext", "unit": "mEq", "initial_value": 700.0, "type": "state", "description": "Extracellular sodium"},
    {"name": "SNS", "unit": "1", "initial_value": 1.0, "type": "state", "description": "Sympathetic Nervous System activity (0-2)"},
    {"name": "AngII", "unit": "1", "initial_value": 1.0, "type": "state", "description": "Angiotensin II level (0-5)"}
  ],
  "parameters": [
    {"name": "Na_intake", "unit": "mEq/min", "value": 0.1},
    {"name": "H2O_intake", "unit": "mL/min", "value": 1.0},
    {"name": "R_total_base", "unit": "mmHg*min/mL", "value": 0.02},
    {"name": "C_total", "unit": "mL/mmHg", "value": 100.0},
    {"name": "K_renal", "unit": "mL/min/mmHg", "value": 0.05, "description": "Renal pressure-diuresis slope"},
    {"name": "K_baro_gain", "unit": "1/mmHg", "value": 0.1, "description": "Baroreflex sensitivity"},
    {"name": "K_raas_gain", "unit": "1/mmHg", "value": 0.05, "description": "RAAS sensitivity to pressure drop"}
  ],
  "equations": [
    {"target": "MAP", "expression": "(ECBV / C_total) * (1.0 + 0.5*(SNS-1.0) + 0.2*(AngII-1.0)) - MAP * 0.1"},
    {"target": "ECBV", "expression": "H2O_intake - K_renal * (MAP - 80.0) * (1.0 - 0.3*(AngII-1.0))"},
    {"target": "Na_ext", "expression": "Na_intake - (Na_ext / ECBV) * (K_renal * (MAP - 80.0) * (1.0 - 0.3*(AngII-1.0)))"},
    {"target": "SNS", "expression": "K_baro_gain * (100.0 - MAP) - (SNS - 1.0) * 0.5"},
    {"target": "AngII", "expression": "K_raas_gain * (90.0 - MAP) - (AngII - 1.0) * 0.2"}
  ],
  "events": [
    {"name": "High Salt Loading", "condition": "t - 100.0", "action": "Na_intake = 0.5"},
    {"name": "Acute Hemorrhage", "condition": "t - 500.0", "action": "ECBV = ECBV - 1000.0"},
    {"name": "ACE Inhibitor Administration", "condition": "t - 1000.0", "action": "K_raas_gain = 0.0"}
  ]
}
